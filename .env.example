# Copy this file to .env and fill it in. .env stays out of Git.

# The watch sends this with every upload. Use the same value in watch/config.py (TOKEN).
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
GYM_BUDDY_TOKEN=

# The dashboard asks for this in the browser. Any user name works.
GYM_BUDDY_PASSWORD=

# Only for --profile https: the name that points at this machine, e.g. yourname.duckdns.org
GYM_BUDDY_DOMAIN=
